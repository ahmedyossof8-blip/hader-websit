# ==============================================================================
# HADER-V2: Environment Configuration Template (.env.example)
# Copy this file to .env and populate with your environment-specific credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Server & Network Settings
PORT=8080
APP_ENV=production
ALLOWED_ORIGIN=https://hader-v2.vercel.app,*.vercel.app,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection Pooler (Port 6543 / Supavisor)
# ------------------------------------------------------------------------------
# Obtain from Supabase Dashboard -> Project Settings -> Database -> Connection string -> Transaction Mode (Port 6543)
# Format: postgres://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgres://postgres.yourprojectref:yoursecurepassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Supabase Authentication & In-Memory JWT Secret
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
# The backend validates incoming Bearer tokens locally in-memory using HMAC-SHA256 (sub-millisecond latency).
JWT_SECRET=your_supabase_jwt_secret_minimum_32_characters_long
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_minimum_32_characters_long

# ------------------------------------------------------------------------------
# Supabase API Credentials (Optional / Future client hooks)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# Edge Proxy & Caddy HTTPS Settings (For Docker VPS deployment)
# ------------------------------------------------------------------------------
DOMAIN=api.hader-app.edu.eg
ACME_EMAIL=admin@hader-app.edu.eg
